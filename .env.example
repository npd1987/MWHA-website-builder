# Copy this file to .env (which git ignores) and fill it in. Never commit real tokens.
# Run the publisher with:  node --env-file=.env tools/publisher/src/cli.ts check

# The cPanel server your hosting account lives on (shown in WHM / cPanel's address bar)
CPANEL_HOST=server123.example.com
# The customer's cPanel user name to publish into (use a test account first)
CPANEL_USER=testsite

# Option A: a cPanel API token for that account (cPanel > Security > Manage API Tokens)
# CPANEL_TOKEN=

# Option B: your reseller WHM API token (WHM > Development > Manage API Tokens)
# The publisher uses it to create a 1-hour cPanel token for CPANEL_USER on each run.
WHM_USER=yourreseller
WHM_TOKEN=
